<?xml version="1.0" encoding="utf-8" ?>
<configuration>
    <startup> 
        <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.7.2" />
    </startup>
	<appSettings>
		<add key="ConnectionString" value="Server=.;Database=MoneyMindManager;Integrated Security=True;"/>
		<add key="BackupFolder" value="E:\DatabaseBackups"/>
		<add key="LogFolder" value="E:\DatabaseBackups\Logs"/>
		<add key="BackupIntervalDays" value="10"/>
	</appSettings>
</configuration>